{
  "name": "@aninganing/react",
  "version": "0.0.1",
  "description": "React component library for the aning design system.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aninganing/aning-design-system.git",
    "directory": "packages/components"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@aninganing/icons": "workspace:*",
    "@aninganing/tokens": "workspace:*",
    "@aninganing/utils": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@aninganing/eslint-config": "workspace:*",
    "@aninganing/stylelint-config": "workspace:*",
    "@aninganing/typescript-config": "workspace:*",
    "@storybook/react": "^8.4.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylelint": "^16.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
