{
  "color": {
    "bg": {
      "default": { "$type": "color", "$value": "{color.gray.950}" },
      "subtle": { "$type": "color", "$value": "{color.gray.900}" },
      "inverse": { "$type": "color", "$value": "{color.white}" },
      "muted": { "$type": "color", "$value": "{color.gray.800}" },
      "muted-highlight": { "$type": "color", "$value": "{color.gray.700}" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.gray.50}" },
      "subtle": { "$type": "color", "$value": "{color.gray.400}" },
      "inverse": { "$type": "color", "$value": "{color.gray.900}" },
      "danger": { "$type": "color", "$value": "{color.red.500}" },
      "accent": { "$type": "color", "$value": "{color.blue.300}" },
      "on-accent-subtle": { "$type": "color", "$value": "{color.gray.300}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.gray.700}" },
      "focus": { "$type": "color", "$value": "{color.blue.400}" },
      "control": { "$type": "color", "$value": "{color.gray.500}" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "{color.blue.500}" },
      "hover": { "$type": "color", "$value": "{color.blue.400}" },
      "subtle": { "$type": "color", "$value": "{color.blue.900}" }
    },
    "danger": {
      "default": { "$type": "color", "$value": "{color.red.500}" },
      "hover": { "$type": "color", "$value": "{color.red.600}" },
      "subtle": { "$type": "color", "$value": "{color.gray.900}" }
    },
    "success": {
      "default": { "$type": "color", "$value": "{color.green.500}" }
    },
    "control": {
      "thumb": { "$type": "color", "$value": "{color.white}" }
    }
  }
}
