{
  "shadow": {
    "sm": {
      "$type": "boxShadow",
      "$value": { "x": "0", "y": "1px", "blur": "2px", "spread": "0", "color": "rgba(0, 0, 0, 0.1)", "type": "dropShadow" }
    },
    "md": {
      "$type": "boxShadow",
      "$value": { "x": "0", "y": "4px", "blur": "6px", "spread": "-1px", "color": "rgba(0, 0, 0, 0.15)", "type": "dropShadow" }
    }
  }
}
