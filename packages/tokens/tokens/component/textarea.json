{
  "textarea": {
    "bg": { "$type": "color", "$value": "{input.bg.default}" },
    "border": {
      "default": { "$type": "color", "$value": "{input.border.default}" },
      "focus": { "$type": "color", "$value": "{input.border.focus}" },
      "error": { "$type": "color", "$value": "{input.border.error}" }
    },
    "text": { "$type": "color", "$value": "{input.text}" },
    "placeholder": { "$type": "color", "$value": "{input.placeholder}" },
    "radius": { "$type": "borderRadius", "$value": "{input.radius}" },
    "paddingX": { "$type": "spacing", "$value": "{input.paddingX}" },
    "paddingY": { "$type": "spacing", "$value": "{input.paddingY}" },
    "description": { "$type": "color", "$value": "{color.text.subtle}" },
    "count": {
      "default": { "$type": "color", "$value": "{color.text.subtle}" },
      "limit": { "$type": "color", "$value": "{color.text.danger}" }
    }
  }
}
