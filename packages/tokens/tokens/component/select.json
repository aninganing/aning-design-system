{
  "select": {
    "bg": { "$type": "color", "$value": "{input.bg.default}" },
    "border": {
      "default": { "$type": "color", "$value": "{input.border.default}" },
      "focus": { "$type": "color", "$value": "{input.border.focus}" },
      "error": { "$type": "color", "$value": "{input.border.error}" }
    },
    "text": { "$type": "color", "$value": "{input.text}" },
    "placeholder": { "$type": "color", "$value": "{input.placeholder}" },
    "icon": { "$type": "color", "$value": "{color.text.subtle}" },
    "radius": { "$type": "borderRadius", "$value": "{input.radius}" },
    "paddingX": { "$type": "spacing", "$value": "{input.paddingX}" },
    "content": {
      "bg": { "$type": "color", "$value": "{color.bg.default}" },
      "border": { "$type": "color", "$value": "{color.border.default}" },
      "radius": { "$type": "borderRadius", "$value": "{radius.md}" },
      "shadow": { "$type": "boxShadow", "$value": "{shadow.md}" }
    },
    "item": {
      "bg": {
        "highlighted": { "$type": "color", "$value": "{color.bg.muted}" }
      },
      "highlight-bar": { "$type": "color", "$value": "{color.accent.default}" },
      "text": {
        "default": { "$type": "color", "$value": "{color.text.default}" },
        "disabled": { "$type": "color", "$value": "{color.text.subtle}" }
      },
      "indicator": { "$type": "color", "$value": "{color.text.accent}" },
      "radius": { "$type": "borderRadius", "$value": "{radius.sm}" }
    }
  }
}
