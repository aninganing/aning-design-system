{
  "alert": {
    "gap": { "$type": "spacing", "$value": "{space.3}" },
    "padding": {
      "y": { "$type": "spacing", "$value": "{space.3}" },
      "x": { "$type": "spacing", "$value": "{space.4}" }
    },
    "radius": { "$type": "borderRadius", "$value": "{radius.md}" },
    "title": { "$type": "color", "$value": "{color.text.default}" },
    "info": {
      "bg": { "$type": "color", "$value": "{color.accent.subtle}" },
      "icon": { "$type": "color", "$value": "{color.text.accent}" },
      "description": { "$type": "color", "$value": "{color.text.on-accent-subtle}" }
    },
    "neutral": {
      "bg": { "$type": "color", "$value": "{color.bg.subtle}" },
      "icon": { "$type": "color", "$value": "{color.text.subtle}" },
      "description": { "$type": "color", "$value": "{color.text.subtle}" }
    },
    "danger": {
      "bg": { "$type": "color", "$value": "{color.bg.default}" },
      "border": { "$type": "color", "$value": "{color.danger.default}" },
      "icon": { "$type": "color", "$value": "{color.danger.default}" },
      "description": { "$type": "color", "$value": "{color.text.subtle}" }
    }
  }
}
