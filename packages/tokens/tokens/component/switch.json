{
  "switch": {
    "gap": { "$type": "spacing", "$value": "{space.4}" },
    "radius": { "$type": "borderRadius", "$value": "{radius.full}" },
    "track": {
      "off": { "$type": "color", "$value": "{color.border.control}" },
      "on": { "$type": "color", "$value": "{color.accent.default}" }
    },
    "thumb": {
      "bg": { "$type": "color", "$value": "{color.control.thumb}" },
      "shadow": { "$type": "boxShadow", "$value": "{shadow.sm}" }
    },
    "label": { "$type": "color", "$value": "{color.text.default}" },
    "description": { "$type": "color", "$value": "{color.text.subtle}" }
  }
}
