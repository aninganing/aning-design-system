{
  "number-stepper": {
    "gap": { "$type": "spacing", "$value": "{space.3}" },
    "button": {
      "fg": {
        "default": { "$type": "color", "$value": "{color.text.default}" },
        "disabled": { "$type": "color", "$value": "{color.text.subtle}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.border.control}" },
        "disabled": { "$type": "color", "$value": "{color.border.default}" }
      },
      "bg": {
        "default": { "$type": "color", "$value": "{color.bg.default}" },
        "hover": { "$type": "color", "$value": "{color.bg.subtle}" }
      },
      "radius": { "$type": "borderRadius", "$value": "{radius.full}" }
    },
    "value": {
      "fg": { "$type": "color", "$value": "{color.text.default}" }
    }
  }
}
