{
  "name": "@aninganing/utils",
  "version": "0.0.0",
  "description": "Shared React hooks and utilities for the aning design system.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aninganing/aning-design-system.git",
    "directory": "packages/utils"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@aninganing/eslint-config": "workspace:*",
    "@aninganing/typescript-config": "workspace:*",
    "@types/react": "^18.3.18",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
